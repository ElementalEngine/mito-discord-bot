# Mite environment template. The bot reads .env.<NODE_ENV> from its working
# directory: .env.development by default, .env.production when NODE_ENV says so.
# NODE_ENV itself comes from the service, not from this file.
#
# Every id is a Discord snowflake (17 to 20 digits); one left empty turns off
# what uses it. A commented line shows its default: uncomment it only to
# change it, since an empty value replaces the default.

# Discord application
BOT_TOKEN=
BOT_CLIENT_ID=
DISCORD_GUILD_ID=

# core-api: Mite's service token, and where core-api listens
BACKEND_SERVICE_TOKEN=
# BACKEND_SERVICE_URL=http://localhost:8001

# The https redirect a Steam lobby link goes out through, by NODE_ENV
# LOBBY_LINK_URL=https://dev-lobbylink.elementalengine.net
# debug, info, warn or error
# LOG_LEVEL=info

# Command channels
CHANNEL_BOT_COMMANDS_ID=
CHANNEL_REPORT_LOG=
CHANNEL_CIV6_COMMANDS_ID=
CHANNEL_CIV7_COMMANDS_ID=
CHANNEL_CLOUD_COMMANDS_ID=
CHANNEL_NOVICE_COMMANDS_ID=

# /lobby is hosted here; /vote runs in the vote channels
CHANNEL_CIV6_LOBBY_LINKS_ID=
CHANNEL_CIV6_FFA_VOTE_ID=
CHANNEL_CIV6_TEAMER_VOTE_ID=
CHANNEL_CIV7_FFA_VOTE_ID=
CHANNEL_CIV7_TEAMER_VOTE_ID=

# Reports are uploaded in one channel and their results posted in another
CHANNEL_CIV6_REALTIME_UPLOADS_ID=
CHANNEL_CIV6_REALTIME_REPORTING_HISTORY_ID=
CHANNEL_CIV7_REALTIME_UPLOADS_ID=
CHANNEL_CIV7_REALTIME_REPORTING_HISTORY_ID=
CHANNEL_CIV6_CLOUD_UPLOADS_ID=
CHANNEL_CIV6_CLOUD_REPORTING_HISTORY_ID=
CHANNEL_CIV7_CLOUD_UPLOADS_ID=
CHANNEL_CIV7_CLOUD_REPORTING_HISTORY_ID=

# Leaderboard threads, one per board
CHANNEL_CIV6_REALTIME_FFA_LEADERBOARD_ID=
CHANNEL_CIV6_REALTIME_DUEL_LEADERBOARD_ID=
CHANNEL_CIV6_REALTIME_TEAMER_LEADERBOARD_ID=
CHANNEL_CIV6_REALTIME_SEASONAL_FFA_LEADERBOARD_ID=
CHANNEL_CIV6_REALTIME_SEASONAL_DUEL_LEADERBOARD_ID=
CHANNEL_CIV6_REALTIME_SEASONAL_TEAMER_LEADERBOARD_ID=
CHANNEL_CIV6_PBC_FFA_LEADERBOARD_ID=
CHANNEL_CIV6_PBC_DUEL_LEADERBOARD_ID=
CHANNEL_CIV6_PBC_TEAMER_LEADERBOARD_ID=
CHANNEL_CIV6_PBC_COMBINED_LEADERBOARD_ID=
CHANNEL_CIV7_REALTIME_FFA_LEADERBOARD_ID=
CHANNEL_CIV7_REALTIME_DUEL_LEADERBOARD_ID=
CHANNEL_CIV7_REALTIME_TEAMER_LEADERBOARD_ID=
CHANNEL_CIV7_REALTIME_SEASONAL_FFA_LEADERBOARD_ID=
CHANNEL_CIV7_REALTIME_SEASONAL_DUEL_LEADERBOARD_ID=
CHANNEL_CIV7_REALTIME_SEASONAL_TEAMER_LEADERBOARD_ID=
CHANNEL_CIV7_PBC_FFA_LEADERBOARD_ID=
CHANNEL_CIV7_PBC_DUEL_LEADERBOARD_ID=
CHANNEL_CIV7_PBC_TEAMER_LEADERBOARD_ID=
CHANNEL_CIV7_PBC_COMBINED_LEADERBOARD_ID=

# Who may run what: staff, and the rank roles players hold
ROLE_DEVELOPER=
ROLE_ADMIN=
ROLE_MODERATOR=
ROLE_NOVICE_MANAGER=
ROLE_CIV6_RANKED=
ROLE_CIV7_RANKED=
ROLE_CLOUD=
# Pinged when a lobby asks for players
ROLE_CIV6_LFG=

# The rank roles Mite gives by rating; the bot's role must sit above them all
ROLE_RANK_DEITY_3_STAR=
ROLE_RANK_DEITY_2_STAR=
ROLE_RANK_DEITY=
ROLE_RANK_IMMORTAL=
ROLE_RANK_EMPEROR=
ROLE_RANK_KING=
ROLE_RANK_PRINCE=
ROLE_RANK_WARLORD=
ROLE_RANK_CHIEFTAIN=
ROLE_RANK_SETTLER=
ROLE_RANK_BUILDER=
ROLE_RANK_SCOUT=
