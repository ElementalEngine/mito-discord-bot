# Server -- apps/activity/.env.<NODE_ENV>
PORT=3100
CORE_API_URL=http://127.0.0.1:8001
ACTIVITY_SERVICE_TOKEN=            # must equal core-api's activity_service_token
ACTIVITY_SESSION_SIGNING_KEY=      # 32 random bytes hex; never the service token
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
STAFF_ROLE_IDS=                    # comma-separated: ROLE_DEVELOPER, ROLE_MODERATOR.
                                   # A holder watches a lobby uncensored — but not
                                   # while seated in one, which core-api enforces.

# Client -- read by vite at build time from .env.production, or .env.development for the dev server
VITE_DISCORD_CLIENT_ID=            # same value as DISCORD_CLIENT_ID; not secret
