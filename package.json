{
  "name": "mito-workspace",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24.18.0" },
  "workspaces": ["apps/*", "packages/*"],
  "overrides": { "undici": "6.27.0" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run pins && npm run build",
    "pins": "node scripts/version-pins.mjs",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "gen:contracts:check": "node scripts/gen-contracts.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "endOfLine": "auto"
  }
}
